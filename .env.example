# Lillian Siyoi 2027 Campaign Server — environment template
# --------------------------------------------------------
# Production template: the CI/CD workflow copies this to `.env` on the VPS
# on the first deploy (only AUTH_SECRET is rotated). Keep it production-shaped.
# DO NOT put real secrets here — this file is tracked in git.
# After the first deploy, review /var/www/lcs2027-server/.env and set real
# CORS_ORIGINS, BETTER_AUTH_URL and DATABASE_URL values.

# HTTP port for the API.
PORT=4000

NODE_ENV=production

# Comma separated list of allowed CORS origins.
# Add the deployed client origin here (e.g. the Vercel app) and keep
# localhost:2027 so the local client can talk to a production API too.
CORS_ORIGINS=https://lilliansiyoi.top,https://YOUR-CLIENT-DOMAIN.vercel.app,http://localhost:2027

# Target general election day (default: 2027 Kenyan General Election)
ELECTION_DAY=2027-08-10

# Better Auth signing secret for session JWTs and cookie signing.
# The deploy workflow replaces this value with `openssl rand -base64 48`
# when it generates .env on the VPS for the first time.
AUTH_SECRET=rotated-on-first-deploy-by-workflow

# Public base URL of this API — where the auth client sends credentials.
# Must be HTTPS once the client is served over HTTPS (e.g. Cloudflare in front).
BETTER_AUTH_URL=https://api.YOUR-DOMAIN.example

# Optional overrides for the JSON-file auth store and audit log (defaults below).
# AUTH_STORE_FILE=data/auth-store.json
# AUDIT_DIR=data/audit

# --- Database ---
# Production: MySQL on the VPS. The deploy workflow creates the database
# automatically with these credentials (`CREATE DATABASE IF NOT EXISTS`) —
# Prisma cannot create the database itself.
# Local development: SQLite instead:
#   DATABASE_URL="file:./app.db"

DATABASE_URL="mysql://medremote:Infinia_Pwd_19805162!@127.0.0.1:3306/lcs2027"
