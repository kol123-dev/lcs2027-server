# Lillian Siyoi 2027 Campaign Server
PORT=4000
NODE_ENV=development
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:2027
# Target general election day (default: 2027 Kenyan General Election)
ELECTION_DAY=2027-08-10
# Better Auth signing secret for session JWTs and cookie signing.
# Generate a long random value for production, e.g. `openssl rand -base64 48`.
AUTH_SECRET=dev-only-war-room-secret-change-me-aiG5Np8zXk2Q9wV1
# Public base URL of this API (where the auth client sends credentials).
BETTER_AUTH_URL=http://localhost:4000
# Optional overrides for the JSON-file auth store and audit log.
# AUTH_STORE_FILE=data/auth-store.json
# AUDIT_DIR=data/audit
# --- Database ---
# Local development: SQLite (created by `npm run db:push && npm run db:seed`).
DATABASE_URL="file:./app.db"
#
# Production on the VPS: point at the already-installed MySQL server. Deploys
# generate/push against prisma/schema.mysql.prisma (`npm run db:push:prod`);
# leave the local SQLite line above untouched for dev.
#   DATABASE_URL="mysql://lcs2027_user:your_password@localhost:3306/lcs2027"
# Prisma cannot create the database itself — the deploy workflow runs
# `CREATE DATABASE IF NOT EXISTS` automatically using these credentials.