{
  "name": "lillian-siyoi-campaign-server",
  "version": "1.0.0",
  "private": true,
  "description": "Lillian Siyoi 2027 Campaign Strategy & Operations API - Trans-Nzoia County Woman Representative (UDA)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.mysql.prisma",
    "db:generate:prod": "prisma generate --schema prisma/schema.mysql.prisma",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:prod": "node prisma/seed.mjs",
    "db:studio": "prisma studio --port 5555"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
