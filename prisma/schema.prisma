// Lillian Siyoi 2027 Campaign — database schema (SQLite via Prisma).
//
// The IEBC 2022 baseline extracted from `data/2022 Baseline.xlsx` is loaded
// into these tables by `prisma/seed.mjs` (= `npm run db:seed`). The API boots
// from the database; `src/data/context.js` reads it into the enriched store
// every consumer already uses.
//
// Better Auth (username + password, roles) also lives here — models are named
// exactly `user` / `session` / `account` / `verification` so the bundled
// Prisma adapter can address them via `prisma.user` etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- IEBC 2022 baseline ----------------

model SubCounty {
  id         String   @id // slug e.g. "kwanza"
  name       String   @unique // "KWANZA"
  registered Int
  cast       Int
  rejected   Int
  valid      Int
  siyoi      Int
  khatundi   Int
  nakhumicha Int
  margin     Int
  opponent   String?
  turnoutPct Float?
  siyoiShare Float?
  candidates String   @default("{}") // JSON: candidateKey -> votes
  wards      Ward[]
}

model Ward {
  id           String  @id // slug e.g. "matisi-ward"
  name         String
  constituency String // sub-county name ("SABOTI")
  wardCode     String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  leader       String?
  margin       Int
  siyoiShare   Float?
  status       String? // officials' sticker: Stronghold | Marginal | Opposition
  candidates   String  @default("{}") // JSON: candidateKey -> votes
  subCountyId  String
  subCounty    SubCounty   @relation(fields: [subCountyId], references: [id])
  stations     Station[]
  centres      Centre[]
  readiness    WardReadiness?
  agents       Agent[]

  @@index([subCountyId])
  @@index([constituency])
}

model Station {
  // NOTE: the seed JSON contains six IEBC codes that each appear as two
  // distinct rows (same centre, different reconciled tallies), so the polling
  // station code CANNOT be the primary key. Rows are re-created from the seed
  // on every `db:seed` run with a deterministic autoincrement id + sortOrder,
  // preserving all 757 station rows byte-for-byte like centres.
  id           Int     @id @default(autoincrement())
  code         String // IEBC code, NOT unique (see note above)
  name         String
  constituency String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  verification String?
  candidates   String  @default("{}") // JSON: candidateKey -> votes
  sortOrder    Int     @default(0)
  wardId       String
  ward         Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([code])
  @@index([name])
  @@index([sortOrder])
}

model Centre {
  id             Int     @id @default(autoincrement())
  name           String
  constituency   String
  ward           String // ward name
  wardCode       String
  registered     Int
  cast           Int
  rejected       Int
  valid          Int
  status         String // Stronghold | Marginal | Opposition
  statusOfficial Boolean
  candidates     String  @default("{}") // JSON: candidateKey -> votes
  sortOrder      Int     @default(0)
  // Per-centre campaign content — written by staff via PATCH /api/centres/:id.
  keyAchievements String  @default("[]") // JSON string[] of headline wins
  campaignMessage  String  @default("")  // one-line campaign message
  wardId         String
  wardRel        Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([name])
  @@index([sortOrder])
}

model Candidate {
  key   String @id // e.g. "lcs" | "khatundi"
  name  String
  short String
  votes Int
  share Float?
  rank  Int
}

// Generic JSON key/value rows (meta, reconciliation, targets, notes).
model MetaRow {
  key   String @id
  value String // JSON
}

// Grassroots field readiness — written by PATCH /api/field/readiness/:wardId.
model WardReadiness {
  wardId             String   @id
  captainsRecruited  Int      @default(0)
  captainsTrained    Int      @default(0)
  agentsRecruited    Int      @default(0)
  agentsTrained      Int      @default(0)
  parallelTallyReady Int      @default(0)
  gotvBriefed        Int      @default(0)
  updatedAt          DateTime @updatedAt
  ward               Ward     @relation(fields: [wardId], references: [id])
}

// ---------------- Field Ops: polling agent roster ----------------

// One row per recruited agent. Coverage is planned against the 757 polling
// stations — 1 primary agent per station, plus backup and supervisor tiers who
// each cover a block of stations (see src/services/agents.js for live targets).
// Ward is the deployment unit; agents are deliberately NOT referenced to a
// Station row because `db:seed` re-creates those rows and their ids can shift.
model Agent {
  id        String   @id @default(cuid())
  fullName  String
  idNumber  String   @unique // national ID
  gender    String // "male" | "female"
  phone     String   @unique // 254XXXXXXXXX
  altPhone  String? // alternative reachable line
  role      String // "primary" | "backup" | "supervisor"
  status    String   @default("active") // "active" | "inactive"
  wardId    String?
  ward      Ward?    @relation(fields: [wardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wardId])
  @@index([role])
  @@index([status])
}

// ---------------- Better Auth (username + password + roles) ----------------

model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // username plugin: the Kenyan mobile number (254XXXXXXXXX)
  username      String?   @unique
  // additional fields, server-managed
  role          String?
  subCounty     String?
  sessions      session[]
  accounts      account[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}