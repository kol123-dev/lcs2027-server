// Lillian Siyoi 2027 Campaign — database schema (SQLite via Prisma).
//
// The IEBC 2022 baseline extracted from `data/2022 Baseline.xlsx` is loaded
// into these tables by `prisma/seed.mjs` (= `npm run db:seed`). The API boots
// from the database; `src/data/context.js` reads it into the enriched store
// every consumer already uses.
//
// Better Auth (username + password, roles) also lives here — models are named
// exactly `user` / `session` / `account` / `verification` so the bundled
// Prisma adapter can address them via `prisma.user` etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- IEBC 2022 baseline ----------------

model SubCounty {
  id         String   @id // slug e.g. "kwanza"
  name       String   @unique // "KWANZA"
  registered Int
  cast       Int
  rejected   Int
  valid      Int
  siyoi      Int
  khatundi   Int
  nakhumicha Int
  margin     Int
  opponent   String?
  turnoutPct Float?
  siyoiShare Float?
  candidates String   @default("{}") // JSON: candidateKey -> votes
  wards      Ward[]
}

model Ward {
  id           String  @id // slug e.g. "matisi-ward"
  name         String
  constituency String // sub-county name ("SABOTI")
  wardCode     String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  leader       String?
  margin       Int
  siyoiShare   Float?
  status       String? // officials' sticker: Stronghold | Marginal | Opposition
  candidates   String  @default("{}") // JSON: candidateKey -> votes
  subCountyId  String
  subCounty    SubCounty   @relation(fields: [subCountyId], references: [id])
  stations     Station[]
  centres      Centre[]
  readiness    WardReadiness?
  agents       Agent[]
  blocs        Bloc[]
  activities   CampaignActivity[]
  projectBeneficiaries ProjectBeneficiary[]
  issues       Issue[]

  @@index([subCountyId])
  @@index([constituency])
}

model Station {
  // NOTE: the seed JSON contains six IEBC codes that each appear as two
  // distinct rows (same centre, different reconciled tallies), so the polling
  // station code CANNOT be the primary key. Rows are re-created from the seed
  // on every `db:seed` run with a deterministic autoincrement id + sortOrder,
  // preserving all 757 station rows byte-for-byte like centres.
  id           Int     @id @default(autoincrement())
  code         String // IEBC code, NOT unique (see note above)
  name         String
  constituency String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  verification String?
  candidates   String  @default("{}") // JSON: candidateKey -> votes
  sortOrder    Int     @default(0)
  wardId       String
  ward         Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([code])
  @@index([name])
  @@index([sortOrder])
}

model Centre {
  id             Int     @id @default(autoincrement())
  name           String
  constituency   String
  ward           String // ward name
  wardCode       String
  registered     Int
  cast           Int
  rejected       Int
  valid          Int
  status         String // Stronghold | Marginal | Opposition
  statusOfficial Boolean
  candidates     String  @default("{}") // JSON: candidateKey -> votes
  sortOrder      Int     @default(0)
  // Per-centre campaign content — written by staff via PATCH /api/centres/:id.
  keyAchievements String  @default("[]") // JSON string[] of headline wins
  campaignMessage  String  @default("")  // one-line campaign message
  wardId         String
  wardRel        Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([name])
  @@index([sortOrder])
}

model Candidate {
  key   String @id // e.g. "lcs" | "khatundi"
  name  String
  short String
  votes Int
  share Float?
  rank  Int
}

// Generic JSON key/value rows (meta, reconciliation, targets, notes).
model MetaRow {
  key   String @id
  value String // JSON
}

// Grassroots field readiness — written by PATCH /api/field/readiness/:wardId.
model WardReadiness {
  wardId             String   @id
  captainsRecruited  Int      @default(0)
  captainsTrained    Int      @default(0)
  agentsRecruited    Int      @default(0)
  agentsTrained      Int      @default(0)
  parallelTallyReady Int      @default(0)
  gotvBriefed        Int      @default(0)
  updatedAt          DateTime @updatedAt
  ward               Ward     @relation(fields: [wardId], references: [id])
}

// ---------------- Field Ops: polling agent roster ----------------

// One row per recruited agent. Coverage is planned against the 757 polling
// stations — 1 primary agent per station, plus backup and supervisor tiers who
// each cover a block of stations (see src/services/agents.js for live targets).
//
// The polling station is stored DENORMALISED (IEBC code + centre name) rather
// than as a Station relation: `db:seed` deletes and re-creates every Station
// row, so a foreign key would dangle after each seed. The code is stable in the
// IEBC register, which is what makes it safe to persist.
model Agent {
  id          String   @id @default(cuid())
  fullName    String
  idNumber    String   @unique // national ID
  gender      String // "male" | "female"
  phone       String   @unique // 254XXXXXXXXX
  altPhone    String? // alternative reachable line
  role        String // "primary" | "backup" | "supervisor"
  status      String   @default("active") // "active" | "inactive"
  stationCode String? // IEBC stream code, e.g. "026136067905501"
  stationName String? // polling centre / station name
  wardId      String?
  ward        Ward?    @relation(fields: [wardId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wardId])
  @@index([role])
  @@index([status])
  @@index([stationCode])
  @@index([stationName])
}

// ---------------- Outreach: demographic blocs ----------------

// A bloc is an organised community the outreach plan is actually executed
// against — a farm, a traders' association, a boda SACCO, a savings circle.
// `category` groups them into the blocs the campaign talks about (Farms,
// Business Community — see BLOC_CATEGORIES in src/services/blocs.js).
//
// The polling centre is where the majority of the bloc's members vote. It is
// stored DENORMALISED (IEBC code + centre name) rather than as a Centre
// relation: `db:seed` deletes and re-creates every Centre/Station row, so a
// foreign key would dangle after each seed. The IEBC code is stable in the
// register, which is what makes it safe to persist.
model Bloc {
  id            String   @id @default(cuid())
  name          String   @unique // "Koross Farm"
  category      String // "farm" | "business"
  population    Int      @default(0) // members the bloc speaks for
  engagements   Int      @default(0) // outreach engagements completed (target: BLOC_TARGETS)
  issues        Int      @default(0) // issues logged from the bloc
  messages      Int      @default(0) // key messages delivered to the bloc
  officialName  String // chairman / group official
  officialPhone String // 254XXXXXXXXX
  officialId    String // official's national ID
  stationCode   String? // IEBC code of the majority polling centre
  stationName   String? // that centre's name
  wardId        String?
  ward          Ward?    @relation(fields: [wardId], references: [id])
  keyMessages   String   @default("[]") // JSON string[] — what this bloc hears
  status        String   @default("active") // "active" | "dormant"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       BlocMember[]
  activities    CampaignActivity[]
  issueReports  Issue[]

  @@index([category])
  @@index([wardId])
  @@index([status])
  @@index([stationCode])
}

// One captured member of a bloc. Blocs overlap in real life (a farmer also
// rides in a boda SACCO), so the national ID is unique per bloc rather than
// globally, and phones are indexed but not constrained — informal groups often
// share one handset.
model BlocMember {
  id        String   @id @default(cuid())
  fullName  String
  idNumber  String // national ID
  gender    String // "male" | "female"
  phone     String // 254XXXXXXXXX
  blocId    String
  bloc      Bloc     @relation(fields: [blocId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blocId, idNumber])
  @@index([blocId])
  @@index([phone])
}

// ---------------- Roadmap: dated campaign activities ----------------

// One dated entry on the campaign roadmap — a Mashamba meeting, a ward tour
// day, a harambee, a burial dispatch, a church blitz, a party/coalition
// sitting, or a fixed key event (Christmas, Easter, Eid). Recurring work
// (harambees, burials, church blitzes) is expanded to one row per occurrence
// so the calendar and the "done vs planned" counters stay live.
//
// Links to the rest of the machine are DELIBERATE but loose: the ward/bloc
// relations are real foreign keys (and the ward carries its sub-county, i.e.
// the 2022 baseline geography), while the polling centre is stored
// DENORMALISED (IEBC code + centre name) exactly like Bloc/Agent — `db:seed`
// re-creates Centre/Station rows, so a foreign key would dangle after a seed.
model CampaignActivity {
  id          String    @id @default(cuid())
  title       String
  type        String // mashamba | ward-tour | team-tour | harambee | burial | party | church-blitz | key-event
  category    String    @default("activity") // "activity" | "key-event"
  description String?
  cadence     String    @default("once") // "once" | "weekly" | "monthly"
  date        DateTime // the day this occurrence is planned for
  endDate     DateTime?
  status      String    @default("planned") // "planned" | "active" | "done" | "cancelled"
  location    String? // venue / settler-farm subdivision / church
  subCountyId String?
  wardId      String?
  ward        Ward?     @relation(fields: [wardId], references: [id])
  blocId      String?
  bloc        Bloc?     @relation(fields: [blocId], references: [id])
  stationCode String? // IEBC code of the venue centre, when fixed
  stationName String?
  owner       String? // team / lead responsible
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
  @@index([wardId])
  @@index([subCountyId])
  @@index([blocId])
  @@index([stationCode])
  @@index([status])
}

// ---------------- Projects, initiatives & achievements ----------------

// One programme / initiative / achievement delivered on the ground (Tents &
// Chairs, Scholarships, Pad-a-Girl, Jenga Nyumba, Anti-Jigger…). `slug` is the
// stable public identifier used in /projects URLs; `category` groups the
// programmes into the families the campaign talks about (Economic
// Empowerment, Education, Dignity & Inclusion, Infrastructure, Employment,
// Faith & Community, Sports & Youth).
//
// `unit` labels what a single beneficiary record issues (a mattress, a packet
// of pads, a KSh disbursement) so the register totals read in real units.
model Project {
  id            String   @id @default(cuid())
  slug          String   @unique // "scholarships"
  name          String // "Scholarships & Bursaries"
  category      String // family id, e.g. "education"
  summary       String? // one-line description for the directory card
  description   String? // fuller narrative
  unit          String   @default("beneficiary") // what one record issues
  metric        String   @default("count") // "count" | "amount" — headline metric
  detailFields  String   @default("[]") // JSON: [{key,label}] programme-specific extra fields
  status        String   @default("active") // "active" | "planned" | "completed"
  startDate     DateTime?
  order         Int      @default(0)
  beneficiaries ProjectBeneficiary[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([order])
}

// One beneficiary sheet under a programme — a student, a household, a women's
// group, a school, a place of worship or a team. The core columns are the ones
// every programme needs (beneficiary, guardian, ward/village, nearby polling
// centre, phone, quantity/amount); programme-specific extras (jersey size,
// ID number, recruitment entity, machinery model…) live in `details` as JSON.
//
// The polling centre is stored DENORMALISED (IEBC code + centre name) exactly
// like Bloc/Agent/CampaignActivity — `db:seed` re-creates Centre/Station rows,
// so a foreign key would dangle after a seed.
model ProjectBeneficiary {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // beneficiary / student / group name
  parentName  String? // parent / guardian / group official
  phone       String? // active phone of the contact person
  wardId      String?
  ward        Ward?     @relation(fields: [wardId], references: [id])
  village     String?
  stationCode String? // IEBC code of the nearby polling centre
  stationName String?
  quantity    Int? // items / packets / people
  amount      Float? // KSh disbursed
  dateIssued  DateTime?
  status      String    @default("issued") // "issued" | "pending"
  details     String    @default("{}") // JSON: programme-specific extras
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([wardId])
  @@index([stationCode])
  @@index([name])
  @@index([status])
}

// ---------------- Issues: live problems reported from the ground ----------------

// An issue is a concrete problem people are living with in an area — a cattle
// dip with no acaricide, a broken water point, a market with no lighting. It is
// raised where the campaign meets people: at an outreach bloc, at a polling
// centre, or across a whole ward.
//
// The polling centre is stored DENORMALISED (IEBC code + centre name) exactly
// like Bloc/Agent/CampaignActivity/ProjectBeneficiary — `db:seed` re-creates
// Centre/Station rows, so a foreign key would dangle after a seed.
model Issue {
  id          String    @id @default(cuid())
  title       String // "No acaricide at the cattle dip"
  category    String    @default("other") // water | roads | health | education | agriculture | security | infrastructure | other
  severity    String    @default("medium") // "low" | "medium" | "high"
  status      String    @default("open") // "open" | "in-progress" | "resolved"
  description String?
  reportedBy  String? // person / group who raised it
  reportDate  DateTime?
  wardId      String?
  ward        Ward?     @relation(fields: [wardId], references: [id])
  blocId      String?
  bloc        Bloc?     @relation(fields: [blocId], references: [id])
  stationCode String? // IEBC code of the polling centre it was raised at
  stationName String?
  resolution  String? // what was done, when closed
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([wardId])
  @@index([blocId])
  @@index([stationCode])
  @@index([category])
  @@index([severity])
  @@index([status])
}

// ---------------- Better Auth (username + password + roles) ----------------

model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // username plugin: the Kenyan mobile number (254XXXXXXXXX)
  username      String?   @unique
  // additional fields, server-managed
  role          String?
  subCounty     String?
  // better-auth admin plugin: account suspension (superadmin can ban/unban)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      session[]
  accounts      account[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  // better-auth admin plugin: set when a superadmin impersonates a user
  impersonatedBy String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}