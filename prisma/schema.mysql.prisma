// Lillian Siyoi 2027 Campaign — production database schema (MySQL via Prisma).
//
// Production runs on the VPS MySQL server (see .env -> DATABASE_URL). Local
// dev keeps the SQLite schema (`schema.prisma`); the models are identical in
// both files. ONLY this file is used for production generate / db push
// (`npm run db:push:prod`, or the deploy workflow).
//
// MySQL differences vs the SQLite schema:
//  - Long / JSON-ish strings use @db.Text (SQLite TEXT is unbounded, but
//    MySQL VARCHAR(191) would silently truncate them).
//  - `session.token` is a JWT and needs a unique index — MySQL cannot index
//    TEXT columns, so it uses @db.VarChar(500).
//  - MySQL cannot give TEXT columns literal defaults, so JSON fields use
//    expression defaults `@default(dbgenerated("('...')"))` (valid MySQL 8.0.13+).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- IEBC 2022 baseline ----------------

model SubCounty {
  id         String   @id // slug e.g. "kwanza"
  name       String   @unique // "KWANZA"
  registered Int
  cast       Int
  rejected   Int
  valid      Int
  siyoi      Int
  khatundi   Int
  nakhumicha Int
  margin     Int
  opponent   String?
  turnoutPct Float?
  siyoiShare Float?
  candidates String   @default(dbgenerated("('{}')")) @db.Text // JSON: candidateKey -> votes
  wards      Ward[]
}

model Ward {
  id           String  @id // slug e.g. "matisi-ward"
  name         String
  constituency String // sub-county name ("SABOTI")
  wardCode     String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  leader       String?
  margin       Int
  siyoiShare   Float?
  status       String? // officials' sticker: Stronghold | Marginal | Opposition
  candidates   String  @default(dbgenerated("('{}')")) @db.Text // JSON: candidateKey -> votes
  subCountyId  String
  subCounty    SubCounty   @relation(fields: [subCountyId], references: [id])
  stations     Station[]
  centres      Centre[]
  readiness    WardReadiness?
  agents       Agent[]
  blocs        Bloc[]

  @@index([subCountyId])
  @@index([constituency])
}

model Station {
  // NOTE: the seed JSON contains six IEBC codes that each appear as two
  // distinct rows (same centre, different reconciled tallies), so the polling
  // station code CANNOT be the primary key. Rows are re-created from the seed
  // on every `db:seed` run with a deterministic autoincrement id + sortOrder,
  // preserving all 757 station rows byte-for-byte like centres.
  id           Int     @id @default(autoincrement())
  code         String // IEBC code, NOT unique (see note above)
  name         String
  constituency String
  registered   Int
  cast         Int
  rejected     Int
  valid        Int
  siyoi        Int
  khatundi     Int
  nakhumicha   Int
  verification String?
  candidates   String  @default(dbgenerated("('{}')")) @db.Text // JSON: candidateKey -> votes
  sortOrder    Int     @default(0)
  wardId       String
  ward         Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([code])
  @@index([name])
  @@index([sortOrder])
}

model Centre {
  id             Int     @id @default(autoincrement())
  name           String
  constituency   String
  ward           String // ward name
  wardCode       String
  registered     Int
  cast           Int
  rejected       Int
  valid          Int
  status         String // Stronghold | Marginal | Opposition
  statusOfficial Boolean
  candidates     String  @default(dbgenerated("('{}')")) @db.Text // JSON: candidateKey -> votes
  sortOrder      Int     @default(0)
  // Per-centre campaign content — written by staff via PATCH /api/centres/:id.
  keyAchievements String  @default(dbgenerated("('[]')")) @db.Text // JSON string[] of headline wins
  campaignMessage  String  @default(dbgenerated("('')")) @db.Text // one-line campaign message
  wardId         String
  wardRel        Ward    @relation(fields: [wardId], references: [id])

  @@index([wardId])
  @@index([name])
  @@index([sortOrder])
}

model Candidate {
  key   String @id // e.g. "lcs" | "khatundi"
  name  String
  short String
  votes Int
  share Float?
  rank  Int
}

// Generic JSON key/value rows (meta, reconciliation, targets, notes).
model MetaRow {
  key   String @id
  value String @db.Text // JSON
}

// Grassroots field readiness — written by PATCH /api/field/readiness/:wardId.
model WardReadiness {
  wardId             String   @id
  captainsRecruited  Int      @default(0)
  captainsTrained    Int      @default(0)
  agentsRecruited    Int      @default(0)
  agentsTrained      Int      @default(0)
  parallelTallyReady Int      @default(0)
  gotvBriefed        Int      @default(0)
  updatedAt          DateTime @updatedAt
  ward               Ward     @relation(fields: [wardId], references: [id])
}

// ---------------- Field Ops: polling agent roster ----------------

// One row per recruited agent. Coverage is planned against the 757 polling
// stations — 1 primary agent per station, plus backup and supervisor tiers who
// each cover a block of stations (see src/services/agents.js for live targets).
//
// The polling station is stored DENORMALISED (IEBC code + centre name) rather
// than as a Station relation: `db:seed` deletes and re-creates every Station
// row, so a foreign key would dangle after each seed. The code is stable in the
// IEBC register, which is what makes it safe to persist.
model Agent {
  id          String   @id @default(cuid())
  fullName    String
  idNumber    String   @unique // national ID
  gender      String // "male" | "female"
  phone       String   @unique // 254XXXXXXXXX
  altPhone    String? // alternative reachable line
  role        String // "primary" | "backup" | "supervisor"
  status      String   @default("active") // "active" | "inactive"
  stationCode String? // IEBC stream code, e.g. "026136067905501"
  stationName String? // polling centre / station name
  wardId      String?
  ward        Ward?    @relation(fields: [wardId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wardId])
  @@index([role])
  @@index([status])
  @@index([stationCode])
  @@index([stationName])
}

// ---------------- Outreach: demographic blocs ----------------

// A bloc is an organised community the outreach plan is actually executed
// against — a farm, a traders' association, a boda SACCO, a savings circle.
// `category` groups them into the blocs the campaign talks about (Farms,
// Business Community — see BLOC_CATEGORIES in src/services/blocs.js).
//
// The polling centre is where the majority of the bloc's members vote. It is
// stored DENORMALISED (IEBC code + centre name) rather than as a Centre
// relation: `db:seed` deletes and re-creates every Centre/Station row, so a
// foreign key would dangle after each seed. The IEBC code is stable in the
// register, which is what makes it safe to persist.
model Bloc {
  id            String   @id @default(cuid())
  name          String   @unique // "Koross Farm"
  category      String // "farm" | "business"
  population    Int      @default(0) // members the bloc speaks for
  engagements   Int      @default(0) // outreach engagements completed (target: BLOC_TARGETS)
  issues        Int      @default(0) // issues logged from the bloc
  messages      Int      @default(0) // key messages delivered to the bloc
  officialName  String // chairman / group official
  officialPhone String // 254XXXXXXXXX
  officialId    String // official's national ID
  stationCode   String? // IEBC code of the majority polling centre
  stationName   String? // that centre's name
  wardId        String?
  ward          Ward?    @relation(fields: [wardId], references: [id])
  keyMessages   String   @default(dbgenerated("('[]')")) @db.Text // JSON string[] — what this bloc hears
  status        String   @default("active") // "active" | "dormant"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       BlocMember[]

  @@index([category])
  @@index([wardId])
  @@index([status])
  @@index([stationCode])
}

// One captured member of a bloc. Blocs overlap in real life (a farmer also
// rides in a boda SACCO), so the national ID is unique per bloc rather than
// globally, and phones are indexed but not constrained — informal groups often
// share one handset.
model BlocMember {
  id        String   @id @default(cuid())
  fullName  String
  idNumber  String // national ID
  gender    String // "male" | "female"
  phone     String // 254XXXXXXXXX
  blocId    String
  bloc      Bloc     @relation(fields: [blocId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blocId, idNumber])
  @@index([blocId])
  @@index([phone])
}

// ---------------- Better Auth (username + password + roles) ----------------

model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // username plugin: the Kenyan mobile number (254XXXXXXXXX)
  username      String?   @unique
  // additional fields, server-managed
  role          String?
  subCounty     String?
  sessions      session[]
  accounts      account[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique @db.VarChar(500) // JWT — TEXT can't be indexed on MySQL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}